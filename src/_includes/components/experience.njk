{% import "components/ui.njk" as ui with context %}
<article class="home-entry home-entry--experience section-table experience-entry career-entry" id="{{ experience.id }}">
  <div class="entry-media-cell">
    <div class="experience-logo-stack">
      {% for logo in experience.logos %}
        <div class="experience-logo-card{% if logo.label %} experience-logo-card--labeled{% endif %}">
          <img src="{{ logo.src | sitePath }}" width="{{ logo.width }}" height="{{ logo.height }}" loading="lazy" decoding="async" alt="{{ logo.alt }}" class="{{ logo.className or '' }}">
          {% if logo.label %}<strong class="experience-logo-label">{{ logo.label }}</strong>{% endif %}
        </div>
      {% endfor %}
    </div>
    <div class="entry-media-tags">{{ ui.researchTag(experience.area, researchAreas) }}</div>
  </div>
  <div class="entry-content-cell">
    <div class="split-row">
      <h3 class="entry-title type-entry-title">{{ experience.title }}</h3>
      <span class="text-right experience-side-meta"><span class="entry-meta type-meta">{{ experience.date }}</span></span>
    </div>
    <div class="split-row experience-detail-row"><span class="experience-type type-meta type-meta--uppercase">{{ experience.type }}</span></div>
    <div class="entry-block">
      {{ ui.entryGroupLabel("Contributions") }}
      <ul class="entry-contrib type-body">
        {% for contribution in experience.contributions %}<li>{{ contribution | safe }}</li>{% endfor %}
      </ul>
    </div>
    {% if experience.mentors.length %}<div class="collab-section">
      <h4 class="collab-heading type-group-label">Mentors</h4>
      <div class="collab-list">
        {% for mentor in experience.mentors %}
          <div class="collab-row type-secondary">
            <span class="collab-name">
              {% for person in mentor.people %}
                {% if person.url %}<a href="{{ person.url }}">{{ person.name }}</a>{% else %}{{ person.name }}{% endif %}{% if not loop.last %}, {% endif %}
              {% endfor %}
            </span>
            <span class="collab-org">{{ mentor.organization }}</span>
          </div>
        {% endfor %}
      </div>
    </div>{% endif %}
  </div>
</article>
