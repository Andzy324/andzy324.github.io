{% import "components/ui.njk" as ui with context %}
<article class="home-entry home-entry--project section-table experience-entry project-entry" id="{{ project.id }}">
  <div class="entry-media-cell">
    <div class="entry-visual-stack"><div class="entry-visual">{{ ui.image(project.media, false, "teaser-img") }}</div></div>
    <div class="entry-media-tags">{{ ui.researchTag(project.area, researchAreas) }}</div>
  </div>
  <div class="entry-content-cell">
    <div class="project-title-stack">
      <h3 class="entry-title type-entry-title">{{ project.title }}</h3>
      <div class="project-meta-row"><span class="entry-meta type-meta">{{ project.date }}</span></div>
    </div>
    <div class="split-row experience-detail-row">{{ ui.resourceLinks(project.links, site, project.title + " resources") }}</div>
    <div class="entry-block">{{ ui.entryGroupLabel("Focus") }}<p class="entry-summary type-body">{{ project.focus }}</p></div>
    <div class="entry-block">{{ ui.entryGroupLabel("Overview") }}<p class="entry-summary type-body">{{ project.summary | safe }}</p></div>
    {% if project.collaborators %}<div class="collab-section">
      <h4 class="collab-heading type-group-label">Collaborators</h4>
      <div class="collab-list">
        {% for collaborator in project.collaborators %}
          <div class="collab-row type-secondary">
            <span class="collab-name">
              {% for person in collaborator.people %}
                {% if person.url %}<a href="{{ person.url }}">{{ person.name }}</a>{% else %}{{ person.name }}{% endif %}{% if not loop.last %}, {% endif %}
              {% endfor %}
            </span>
            <span class="collab-org">{{ collaborator.organization }}</span>
          </div>
        {% endfor %}
      </div>
    </div>{% endif %}
    {% if project.mentors and project.mentors.length %}<div class="collab-section">
      <h4 class="collab-heading type-group-label">Mentors</h4>
      <div class="collab-list">
        {% for mentor in project.mentors %}
          <div class="collab-row type-secondary">
            <span class="collab-name">
              {% for person in mentor.people %}
                {% if person.url %}<a href="{{ person.url }}">{{ person.name }}</a>{% else %}{{ person.name }}{% endif %}{% if not loop.last %}, {% endif %}
              {% endfor %}
            </span>
            <span class="collab-org">{{ mentor.organization }}</span>
          </div>
        {% endfor %}
      </div>
    </div>{% endif %}
  </div>
</article>
