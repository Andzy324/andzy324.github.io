---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ '/' | absoluteUrl(site.url) }}</loc><lastmod>{{ site.updated }}</lastmod><priority>1.0</priority></url>
  {% for project in projectPages %}
  <url><loc>{{ ('/projects/' + project.id + '/') | absoluteUrl(site.url) }}</loc><lastmod>{{ site.updated }}</lastmod><priority>0.7</priority></url>
  {% endfor %}
</urlset>
