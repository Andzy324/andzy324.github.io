{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/content.schema.json",
  "$defs": {
    "media": {
      "type": "object",
      "required": ["src", "width", "height", "alt"],
      "properties": {
        "src": { "type": "string", "minLength": 1 },
        "srcset": { "type": "string" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "alt": { "type": "string", "minLength": 1 },
        "className": { "type": "string" },
        "type": { "enum": ["image", "video"] },
        "poster": { "type": "string" }
      },
      "additionalProperties": false
    },
    "resourceLink": {
      "type": "object",
      "required": ["type", "url", "label"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "external": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "person": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "external": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "equal": { "type": "boolean" },
        "corresponding": { "type": "boolean" },
        "lineBreakBefore": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "hero": {
      "type": "object",
      "required": ["bio"],
      "properties": {
        "bio": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "highlight": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "newsItem": {
      "type": "object",
      "required": ["date", "body"],
      "properties": {
        "date": { "type": "string", "minLength": 1 },
        "body": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "researchArea": {
      "type": "object",
      "required": ["id", "label", "theme"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "label": { "type": "string", "minLength": 1 },
        "theme": { "type": "string", "pattern": "^[a-z0-9-]+$" }
      },
      "additionalProperties": false
    },
    "publication": {
      "type": "object",
      "required": ["id", "title", "venue", "year", "area", "media", "authors", "summary", "links"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "venue": { "type": "string", "minLength": 1 },
        "year": { "type": "integer", "minimum": 1900 },
        "area": { "type": "string", "minLength": 1 },
        "media": { "$ref": "#/$defs/media" },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/person" }
        },
        "collaborators": { "type": "array", "items": { "$ref": "#/$defs/mentor" } },
        "mentors": { "type": "array", "items": { "$ref": "#/$defs/mentor" } },
        "shortAuthors": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "links": {
          "type": "array",
          "items": { "$ref": "#/$defs/resourceLink" }
        },
        "award": {
          "type": "object",
          "required": ["label", "url"],
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "mentor": {
      "type": "object",
      "required": ["people", "organization"],
      "properties": {
        "people": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/person" }
        },
        "organization": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "experience": {
      "type": "object",
      "required": ["id", "title", "date", "type", "logos", "contributions", "mentors"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "area": { "type": "string", "minLength": 1 },
        "logos": {
          "type": "array",
          "minItems": 0,
          "items": { "$ref": "#/$defs/media" }
        },
        "contributions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "mentors": {
          "type": "array",
          "minItems": 0,
          "items": { "$ref": "#/$defs/mentor" }
        },
        "collaborators": { "type": "array", "items": { "$ref": "#/$defs/mentor" } }
      },
      "additionalProperties": false
    },
    "education": {
      "type": "object",
      "required": ["id", "institution", "date", "degree", "note", "logo"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "institution": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "minLength": 1 },
        "degree": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 },
        "logo": { "$ref": "#/$defs/media" }
      },
      "additionalProperties": false
    },
    "award": {
      "type": "object",
      "required": ["id", "title", "date", "location", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "projectSection": {
      "type": "object",
      "required": ["id", "title", "body"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "body": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "media": { "$ref": "#/$defs/media" },
        "gallery": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["title", "media"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "media": { "$ref": "#/$defs/media" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "projectDetails": {
      "type": "object",
      "required": ["eyebrow", "claim", "authors", "cover", "sections"],
      "properties": {
        "eyebrow": { "type": "string", "minLength": 1 },
        "claim": { "type": "string", "minLength": 1 },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/person" }
        },
        "cover": { "$ref": "#/$defs/media" },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/projectSection" }
        }
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "required": ["id", "title", "date", "focus", "area", "summary", "media", "links"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "minLength": 1 },
        "focus": { "type": "string", "minLength": 1 },
        "area": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "media": { "$ref": "#/$defs/media" },
        "links": {
          "type": "array",
          "items": { "$ref": "#/$defs/resourceLink" }
        },
        "details": { "$ref": "#/$defs/projectDetails" },
        "collaborators": { "type": "array", "items": { "$ref": "#/$defs/mentor" } },
        "mentors": { "type": "array", "items": { "$ref": "#/$defs/mentor" } }
      },
      "additionalProperties": false
    },
    "homepageSection": {
      "type": "object",
      "required": ["id", "template", "title", "enabled", "navigation"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "template": { "type": "string", "pattern": "^sections/[a-z0-9-]+\\.njk$" },
        "title": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" },
        "navigation": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "site": {
      "type": "object",
      "required": ["url", "pathPrefix", "title", "description", "language", "updated", "owner", "labels", "utilityLinks", "social", "resourceTypes", "features"],
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "pathPrefix": { "type": "string", "pattern": "^/.*/?$|^/$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 2 },
        "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "owner": {
          "type": "object",
          "required": ["name", "alternateNames", "email", "portrait"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "alternateNames": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "email": { "type": "string", "minLength": 3 },
            "portrait": { "$ref": "#/$defs/media" }
          },
          "additionalProperties": false
        },
        "labels": {
          "type": "object",
          "required": ["skipToContent", "primaryNavigation", "openNavigation", "closeNavigation", "profileResources", "moreNews", "lastUpdated", "backHome"],
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "utilityLinks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "url"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "minLength": 1 },
              "external": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "social": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "url", "icon"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "url": { "type": "string" },
              "icon": { "type": "string", "minLength": 1 },
              "external": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "resourceTypes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["label", "icon"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "icon": { "type": "string", "minLength": 1 },
              "className": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "features": {
          "type": "object",
          "required": ["liquidGlassNavigation"],
          "properties": {
            "liquidGlassNavigation": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
